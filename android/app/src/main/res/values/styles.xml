<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/strokuni_primary</item>
        <item name="colorPrimaryDark">@color/strokuni_surface</item>
        <item name="colorAccent">@color/strokuni_primary</item>
        <item name="android:statusBarColor">@color/strokuni_surface</item>
        <item name="android:navigationBarColor">@color/strokuni_surface</item>
        <item name="android:windowLightStatusBar">@bool/strokuni_light_bars</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/strokuni_surface</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/strokuni_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/strokuni_primary</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@color/strokuni_surface</item>
    </style>

    <style name="AppTheme.Alarm" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/strokuni_med_container</item>
        <item name="android:statusBarColor">@color/strokuni_med_container</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
