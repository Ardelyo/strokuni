# Untuk dev lokal. Di Cloud Run nilai ini diisi oleh deploy-gcp.sh (FAMILY_CODES dari Secret Manager).

# Project GCP. Tanpa ini endpoint AI mengembalikan 503 dan aplikasi memakai ringkasan standar tanpa AI.
GOOGLE_CLOUD_PROJECT=gemma4good-494311

# Model Gemini lewat Vertex AI (endpoint global). Utama, lalu cadangan bila utama gagal.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Bila diisi, data disimpan di Firestore (database bernama ini). Kosong = file JSON lokal di DATA_DIR.
FIRESTORE_DATABASE=

# Dev lokal tanpa service account: token sementara, mis. dari `gcloud auth print-access-token`
# GCP_ACCESS_TOKEN=

# Kode rahasia keluarga, dipisah koma. Diisi juga di aplikasi (Lainnya > Server).
FAMILY_CODES=ganti-dengan-kode-panjang-acak

DAILY_CALL_LIMIT=20
RETENTION_DAYS=30
# HP Lio dianggap "diam" bila tidak ada sinyal selama N menit
STALE_MINUTES=180
ALLOWED_ORIGINS=*
PORT=8787
