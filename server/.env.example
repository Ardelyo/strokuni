# Salin ke .env (jangan di-commit) atau isi di dashboard hosting.
ANTHROPIC_API_KEY=sk-ant-...
# Model default: claude-opus-5-5. Untuk biaya lebih rendah: claude-sonnet-5-5 atau claude-haiku-5-5
MODEL=claude-opus-5-5
# Kode rahasia keluarga, dipisah koma. Diisi juga di aplikasi (Lainnya > Server).
FAMILY_CODES=ganti-dengan-kode-panjang-acak
# Batas panggilan AI per keluarga per hari
DAILY_CALL_LIMIT=20
# Data lama dihapus setelah N hari
RETENTION_DAYS=30
# HP Lio dianggap "diam" bila tidak ada sinyal selama N menit
STALE_MINUTES=180
# Origin yang diizinkan (koma). '*' untuk semua. APK memakai https://localhost
ALLOWED_ORIGINS=*
PORT=8787
